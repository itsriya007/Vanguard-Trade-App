rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null && request.auth.uid != null;
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 64 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Test connection endpoint
    match /test/{docId} {
      allow read: if true;
      allow write: if isAuthenticated();
    }

    // User profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow list: if false; // Disallow querying users collection for privacy
      allow create: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == userId
        && request.resource.data.email is string
        && request.resource.data.email.size() <= 120;
      allow update: if isOwner(userId) && isValidId(userId)
        && request.resource.data.uid == userId;
      allow delete: if isOwner(userId);

      // User portfolio subcollection
      match /portfolio/{holdingId} {
        allow read, write: if isOwner(userId) && isValidId(holdingId);
      }

      // User order history subcollection
      match /orders/{orderId} {
        allow read, write: if isOwner(userId) && isValidId(orderId);
      }

      // User price alerts subcollection
      match /alerts/{alertId} {
        allow read, write: if isOwner(userId) && isValidId(alertId);
      }
    }
  }
}
